# .env.example — copy to .env.local and fill in your values

# Hosted PostgreSQL connection string (Supabase / Neon / Railway)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require"

# Vercel injects this header when calling your cron endpoint.
# Generate: openssl rand -hex 32
CRON_SECRET="your-random-secret-here"
